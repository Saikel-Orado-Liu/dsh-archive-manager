{
  "name": "@gamegeek-saikel/dsh-archive-manager",
  "version": "0.3.0",
  "description": "Permanent session deletion for the DSH Web GUI — remove a session's log, workspace accounting, archive/pin markers, projection-cache row, subagent children, and spill data from the sidebar row menu, while DSH's own archive UI keeps owning archived sessions.",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./workspace": "./dsh-archive-manager-workspace/lib/index.js",
    "./projcache": "./dsh-archive-manager-projcache/lib/index.js",
    "./client": "./dsh-archive-manager-client/lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh-archive-manager-workspace",
    "dsh-archive-manager-projcache",
    "dsh-archive-manager-client",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/check-package.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-gateway": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-spill-local": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-registry": "^0.1.7-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.7-rc.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Saikel-Orado-Liu/dsh-archive-manager.git"
  },
  "homepage": "https://github.com/Saikel-Orado-Liu/dsh-archive-manager#readme",
  "bugs": {
    "url": "https://github.com/Saikel-Orado-Liu/dsh-archive-manager/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "session",
    "session-deletion",
    "archive",
    "cordis",
    "typert",
    "workspace",
    "nodejs",
    "esm"
  ],
  "publishConfig": {
    "access": "public"
  }
}
